{
  "name": "lunch-money-de-invest-sync",
  "version": "0.1.0",
  "description": "Sync German investment accounts (Trade Republic, Scalable Capital) into Lunch Money",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "lint": "oxlint -c .oxlintrc.json src",
    "sync": "tsx src/sync.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osloer-industries/lunch-money-de-invest-sync.git"
  },
  "bugs": {
    "url": "https://github.com/osloer-industries/lunch-money-de-invest-sync/issues"
  },
  "homepage": "https://github.com/osloer-industries/lunch-money-de-invest-sync#readme",
  "license": "MIT",
  "dependencies": {
    "@lunch-money/lunch-money-js-v2": "2.11.1",
    "secure-json-parse": "4.1.1",
    "trade-republic-api": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
